{
  "name": "tuff-browse",
  "productName": "tuff.browse",
  "version": "1.3.0",
  "description": "tuff.browse - navegador rápido e privado baseado em Chromium, com extensões e nova aba personalizável",
  "main": "src/main/main.js",
  "author": "tuff.browse",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.pulsebrowser.app",
    "productName": "tuff.browse",
    "copyright": "tuff.browse",
    "artifactName": "tuff.browse-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "tuff.browse",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.20.1",
    "tldts-experimental": "^7.4.19"
  }
}
