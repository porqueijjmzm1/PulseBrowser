{
  "name": "pulsebrowser",
  "productName": "PulseBrowser",
  "version": "1.1.0",
  "description": "PulseBrowser - navegador rápido e privado baseado em Chromium",
  "main": "src/main/main.js",
  "author": "PulseBrowser",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.pulsebrowser.app",
    "productName": "PulseBrowser",
    "copyright": "PulseBrowser",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PulseBrowser",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
